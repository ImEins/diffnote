// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				// this is not the official mypy extension, but it works better than the official since it uses mypy daemon 
				"matangover.mypy",
				"ms-azuretools.vscode-docker",
				"bradlc.vscode-tailwindcss",
				"esbenp.prettier-vscode",
				"rvest.vs-code-prettier-eslint",
				"dbaeumer.vscode-eslint"
			],
			"settings": {
				// post-create script will install mypy globally
				"mypy.dmypyExecutable": "/home/vscode/.pixi/bin/dmypy"
			}
		}
	},
	
	"name": "diffnote",

	// Update the 'dockerComposeFile' list if you have more compose files or use different names.
	// The .devcontainer/docker-compose.yml file contains any overrides you need/want to make.
	"dockerComposeFile": "../docker-compose.yml",

	// The 'service' property is the name of the service for the container that VS Code should
	// use. Update this value and .devcontainer/docker-compose.yml to the real service name.
	"service": "api",

	// The optional 'workspaceFolder' property is the path VS Code should open by default when
	// connected. This is typically a file mount in .devcontainer/docker-compose.yml
	"workspaceFolder": "/workspaces/diffnote",

	// The 'mounts' property is the list of volumes to mount in the container.
	"mounts": [
		"source=diffnote-pixi,target=/workspaces/diffnote/.pixi,type=volume"
	],

	// The 'postCreateCommand' property is the command to run after the container is created.
	"postCreateCommand": "sh .devcontainer/post-create.sh"
}
